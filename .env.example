# ---------------------------------------------------------------------------
# AtelierPro 2.0 — modèle de configuration.
# Copiez ce fichier vers `.env` puis renseignez vos valeurs.
# Aucun secret réel ne doit être versionné.
# ---------------------------------------------------------------------------

# Base PostgreSQL fournie par docker-compose (service `db`)
DATABASE_URL="postgresql://atelierpro:change-me-db-password@localhost:5432/atelierpro?schema=public"

# Environnement : development | test | production
NODE_ENV=development

# Port de l'API et du front servi par Express
PORT=4000

# Origine publique du logiciel (utilisée pour les liens de suivi client)
APP_ORIGIN=http://localhost:4000

# true derrière HTTPS (obligatoire en production)
COOKIE_SECURE=false
TRUST_PROXY=false

# Durée des sessions (jours)
SESSION_TTL_DAYS=30

# Limitation des tentatives de connexion
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# Chemin du build front à servir (laisser vide pour ne servir que l'API)
WEB_DIST=../dist

# Taille maximale du logo (octets)
UPLOAD_MAX_BYTES=400000

# ---------------------------------------------------------------------------
# Identifiants utilisés UNIQUEMENT par docker-compose pour initialiser Postgres.
# Changez-les avant toute mise en production.
# ---------------------------------------------------------------------------
POSTGRES_DB=atelierpro
POSTGRES_USER=atelierpro
POSTGRES_PASSWORD=change-me-db-password

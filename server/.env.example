# AtelierPro 2.0 — configuration du serveur (développement local)

# Connexion PostgreSQL (locale ou Docker)
DATABASE_URL="postgresql://atelierpro:motdepasse_local@127.0.0.1:5432/atelierpro?schema=public"

# Port d'écoute de l'API
PORT=4000

# Origine du front autorisée (CORS + vérification d'origine des mutations)
APP_ORIGIN="http://127.0.0.1:5173"

# Environnement : development | test | production
NODE_ENV=development

# Cookies : true uniquement derrière HTTPS
COOKIE_SECURE=false

# Derrière un reverse proxy (Nginx, Caddy, Traefik…)
TRUST_PROXY=false

# Durée de session en jours
SESSION_TTL_DAYS=30

# Limitation des tentatives de connexion
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# Dossier du build front servi par Express (laisser vide en développement avec Vite)
WEB_DIST=

# Taille maximale du logo (octets, data URL)
UPLOAD_MAX_BYTES=400000
